<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="CommerceGears_Core::core" title="CommerceGears" translate="title" sortOrder="50">
                    <resource id="CommerceGears_ArastaLiveChat::main" title="Arasta Live Chat" translate="title" sortOrder="15">
                        <!-- Granted to the Arasta integration (System > Integrations > API): invoice PDF, version and orders-by-phone endpoints. -->
                        <resource id="CommerceGears_ArastaLiveChat::api" title="Arasta Live Chat API" translate="title" sortOrder="10"/>
                        <resource id="CommerceGears_ArastaLiveChat::config" title="Arasta Live Chat Settings" translate="title" sortOrder="20"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
