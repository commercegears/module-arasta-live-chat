<?php
/**
 * CommerceGears Arasta Live Chat: widget loader for Hyvä themes (vanilla JS, no RequireJS).
 *
 * The identity token and guest cart id come from Hyvä private content (`private-content-loaded`, section
 * `platform-identity`), so full-page-cached HTML never contains them.
 *
 * @var \CommerceGears\ArastaLiveChat\Block\WidgetLoader $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 */
$config = [
    'loaderUrl' => $block->getLoaderUrl(),
    'storeId' => $block->getArastaStoreId(),
    'section' => $block->getSectionName(),
    'consentCategory' => $block->getConsentCategory(),
    'zIndex' => $block->getZIndex(),
    'phoneOffset' => $block->getPhoneBottomOffset(),
];
?>
<?php /* The chat button steps aside while a CommerceGears promo popup is open. */ ?>
<style>.sw-promo-lock [data-platform-widget]{display:none !important}</style>
<script>
    (() => {
        const config = <?= /* @noEscape */ json_encode($config, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES) ?>;
        const SCRIPT_ID = 'platform-widget-loader';
        const MARGIN_MS = 30000;

        /**
         * Moves the Arasta launcher (inside the widget's open shadow root) up on phones by the configured offset.
         * A stylesheet with !important wins over the launcher's inline position.
         */
        function placeLauncher(offset) {
            var css = '@media (max-width: 767px){button[aria-expanded]{bottom:' + (20 + offset) + 'px !important}'
                + 'div[part="panel"]{bottom:' + (92 + offset) + 'px !important;'
                + 'height:min(640px,calc(100vh - ' + (124 + offset) + 'px)) !important}}',
                observer;

            function scan() {
                var host = document.querySelector('[data-platform-widget]'),
                    style;

                if (!host || !host.shadowRoot) {
                    return false;
                }
                if (!host.shadowRoot.querySelector('style[data-cg-offset]')) {
                    style = document.createElement('style');
                    style.setAttribute('data-cg-offset', '');
                    style.textContent = css;
                    host.shadowRoot.appendChild(style);
                }
                return true;
            }

            if (!offset || scan()) {
                return;
            }
            observer = new MutationObserver(function () {
                if (scan()) {
                    observer.disconnect();
                }
            });
            observer.observe(document.body, {childList: true});
        }

        if (document.getElementById(SCRIPT_ID)) {
            return;
        }
        const script = document.createElement('script');
        script.src = config.loaderUrl;
        script.async = true;
        script.id = SCRIPT_ID;
        script.setAttribute('data-store-id', config.storeId);
        if (config.zIndex) {
            script.setAttribute('data-z-index', String(config.zIndex));
        }

        let appended = false;
        let timer = null;
        let retried = false;

        // With CommerceGears Cookie Consent (window.SwConsent) and a category set, the chat waits for that consent.
        const consent = window.SwConsent;
        const gated = Boolean(config.consentCategory && consent && typeof consent.whenGranted === 'function');
        const append = () => {
            if (appended) {
                return;
            }
            appended = true;
            placeLauncher(Number(config.phoneOffset) || 0);
            if (gated) {
                consent.whenGranted(config.consentCategory, () => document.body.appendChild(script));
            } else {
                document.body.appendChild(script);
            }
        };

        const refresh = () => {
            fetch(`${BASE_URL}customer/section/load/?sections=${encodeURIComponent(config.section)}&force_new_section_timestamp=true`, {
                headers: {'X-Requested-With': 'XMLHttpRequest'},
                credentials: 'include'
            })
                .then(response => response.ok ? response.json() : {})
                .then(sections => apply(sections[config.section] || {}))
                .catch(() => {});
        };

        const apply = (data) => {
            let token = (data && data.token) || null;
            const expiresAt = data && data.expiresAt ? data.expiresAt * 1000 : 0;

            if (timer) {
                clearTimeout(timer);
                timer = null;
            }
            if (token && expiresAt && expiresAt - MARGIN_MS <= Date.now()) {
                if (!retried) {
                    retried = true;
                    token = null;
                    refresh();
                }
            } else if (token && expiresAt) {
                retried = false;
                timer = setTimeout(refresh, Math.max(expiresAt - MARGIN_MS - Date.now(), 1000));
            }
            if (token) {
                script.setAttribute('data-customer-token', token);
            } else {
                script.removeAttribute('data-customer-token');
            }
            if (data && data.cartId) {
                script.setAttribute('data-cart-id', data.cartId);
            } else {
                script.removeAttribute('data-cart-id');
            }
            window.dispatchEvent(new CustomEvent('platform:identity', {detail: {token}}));
            append();
        };

        window.addEventListener('private-content-loaded', (event) => {
            const sections = (event.detail && event.detail.data) || {};
            apply(sections[config.section] || {});
        });
        // Load the widget even if private content never arrives (for example with storage disabled).
        setTimeout(append, 3000);
    })();
</script>
<?php if (isset($hyvaCsp)) { $hyvaCsp->registerInlineScript(); } ?>
